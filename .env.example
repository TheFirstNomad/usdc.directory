# ── Supabase ─────────────────────────────────────────────────────────────────
# Required. Get these from your Supabase project dashboard → Settings → API.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
# Optional: explicitly set the project ID (derived from VITE_SUPABASE_URL if omitted)
VITE_SUPABASE_PROJECT_ID=your-project-id

# ── Circle App Kit ────────────────────────────────────────────────────────────
# Required for swap and listing payment features.
# Get from Circle Developer Console → App Kit → Kit Keys.
VITE_ARC_KIT_KEY=KIT_KEY:your-circle-kit-key

# ── WalletConnect / Reown AppKit ─────────────────────────────────────────────
# Optional — a hardcoded fallback is used if this is not set.
# Get from https://cloud.reown.com (formerly WalletConnect Cloud).
VITE_WALLET_CONNECT_PROJECT_ID=your-walletconnect-project-id

# ── Treasury ──────────────────────────────────────────────────────────────────
# Optional — falls back to the hardcoded treasury address in src/lib/web3.ts.
# Only set this if you want to override the default treasury wallet.
VITE_TREASURY_ADDRESS=0x13FA78ab20762c8F49B58D44DBc177a2Adb94D7c
