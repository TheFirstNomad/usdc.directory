          "amount": "10000",
          "asset": "USDC",
          "decimals": 6
        },
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USDC",
            "amount": "0.010000"
          },
          "protocols": [
            {
              "x402": {}
            },
            {
              "mpp": {}
            }
          ],
          "networks": [
            "eip155:8453",
            "eip155:1",
            "eip155:42161",
            "eip155:10",
            "eip155:137",
            "eip155:43114",
            "eip155:130",
            "eip155:480",
            "eip155:146"
          ]
        },
        "responses": {
          "200": {
            "description": "Agent list",
