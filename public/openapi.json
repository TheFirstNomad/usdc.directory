      },
      "AgentResponse": {
        "type": "object",
        "required": [
          "agent"
        ],
        "properties": {
          "agent": {
            "$ref": "#/components/schemas/Agent"
          },
          "paid": {
            "type": [
              "string",
              "null"
            ],
            "description": "Payment reference (tx hash or x402 settlement id)"
          }
        }
      },
      "SelfListRequest": {
        "type": "object",
        "required": [
          "name",
          "wallet_address",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "description": "Agent display name"
          },
          "wallet_address": {
            "type": "string",
            "description": "EVM/Solana/Sui/Near wallet address of the agent",
            "maxLength": 256
          },
          "description": {
            "type": "string",
            "maxLength": 300,
            "description": "What this agent does"
          },
          "logo_url": {
            "type": "string",
            "format": "uri",
            "description": "Public URL of agent logo"
          },
          "website": {
            "type": "string",
            "format": "uri",
            "maxLength": 255,
            "description": "Agent homepage or docs URL"
          },
          "networks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "description": "Chains the agent operates on, e.g. [\"arc\",\"base\"]"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "description": "Capability tags, e.g. [\"payments\",\"search\",\"trading\"]"
          }
        }
      },
      "SelfListResponse": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "paid": {
            "type": [
              "string",
              "null"
            ],
            "description": "Payment reference (tx hash or x402 settlement id)"
          }
        }
      },
      "BoostResponse": {
        "type": "object",
        "required": [
          "id",
          "boosted_until"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "boosted_until": {
            "type": "string",
            "format": "date-time"
          },
          "paid": {
            "type": [
              "string",
              "null"
            ],
            "description": "Payment reference (tx hash or x402 settlement id)"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "PaymentRequired": {
        "description": "Payment required. x402 accepts[] body; PAYMENT-REQUIRED header carries the base64 x402 v2 challenge.",
        "headers": {
          "PAYMENT-REQUIRED": {
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object"
            }
          }
        }
      }
    }
  }
