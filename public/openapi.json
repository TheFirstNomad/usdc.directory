{
  "openapi": "3.1.0",
  "info": {
    "title": "USDC Directory Agent API",
    "version": "1.2.0",
    "description": "Self-list on any chain (EVM, Solana, Sui, or Near) for 1 USDC. Native x402 gasless path on Arc and Base. All other chains: pay USDC to treasury and submit tx hash via X-Payment-TxHash + X-Payment-Chain.",
    "contact": { "name": "USDC Directory", "email": "agents@usdc.directory", "url": "https://usdc.directory" }
  },
  "servers": [
    { "url": "https://ddhytszijvfejnymrwgd.supabase.co/functions/v1/agents-api", "description": "Production" }
  ],
  "x-x402": {
    "version": "1",
    "manifest": "https://usdc.directory/.well-known/x402",
    "evm_treasury": "0x13FA78ab20762c8F49B58D44DBc177a2Adb94D7c",
    "solana_treasury": "4RsopWwQuDLjNC4AdCd3Uzq7w58i9FoE69EgNTB3d4Be",
    "sui_treasury": "0xa15979dcd7429463cdf01aae184cb32e33fcf15d3e46067238ccc384115f9979",
    "near_treasury": "b63a64053204d89290b73e3dbdce660a2f29d211cd1c400f4a499ac165f98171",
    "supported_chains": ["arc","base","ethereum","arbitrum","optimism","polygon","avalanche","bnb","linea","monad","solana","sui","near"],
    "x402_gasless_chains": ["arc","base","ethereum","arbitrum","optimism","polygon","avalanche"]
  },
  "paths": {
    "/agents": {
      "get": {
        "summary": "List AI agents",
        "x-x402-price": { "amount": "1000", "asset": "USDC", "decimals": 6 },
        "responses": {
          "200": { "description": "OK" },
          "402": { "description": "Payment required" }
        }
      },
      "post": {
        "summary": "Self-list a new AI agent (any chain)",
        "x-x402-price": { "amount": "1000000", "asset": "USDC", "decimals": 6 },
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "required": ["name", "wallet_address", "description"],
            "properties": {
              "name": { "type": "string", "maxLength": 100 },
              "wallet_address": { "type": "string", "description": "EVM/Solana/Sui/Near wallet address of the agent" },
              "description": { "type": "string", "maxLength": 300 },
              "logo_url": { "type": "string", "format": "uri" },
              "website": { "type": "string", "format": "uri", "maxLength": 255 },
              "networks": { "type": "array", "items": { "type": "string" }, "maxItems": 10, "description": "Chains the agent operates on" },
              "capabilities": { "type": "array", "items": { "type": "string" }, "maxItems": 20, "description": "Agent capability tags, e.g. payments, search, trading" }
            }
          } } }
        },
        "responses": { "201": { "description": "Created" }, "402": { "description": "Payment required" } }
      }
    },
    "/agents/search": {
      "get": {
        "summary": "Search AI agents by name or description",
        "x-x402-price": { "amount": "1000", "asset": "USDC", "decimals": 6 },
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" }, "description": "Search query (matches name and description)" }
        ],
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "q param required" },
          "402": { "description": "Payment required" }
        }
      }
    },
    "/agents/{id}": {
      "get": {
        "summary": "Fetch one agent",
        "x-x402-price": { "amount": "1000", "asset": "USDC", "decimals": 6 },
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "OK" }, "402": { "description": "Payment required" }, "404": { "description": "Not found" } }
      }
    },
    "/agents/{id}/boost": {
      "post": {
        "summary": "Boost an agent listing (30-day featured)",
        "x-x402-price": { "amount": "5000000", "asset": "USDC", "decimals": 6 },
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Boosted" }, "402": { "description": "Payment required" } }
      }
    }
  }
}
