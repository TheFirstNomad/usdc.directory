            "format": "date-time"
          }
        }
      },
      "AgentSearchResult": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Agent"
          },
          {
            "type": "object",
            "properties": {
              "wallet_address": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        ]
      },
      "AgentList": {
        "type": "object",
        "required": [
          "count",
          "agents"
        ],
        "properties": {
          "count": {
            "type": "integer"
          },
          "agents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Agent"
            }
          },
          "paid": {
            "type": [
              "string",
              "null"
            ],
            "description": "Payment reference (tx hash or x402 settlement id)"
          }
        }
      },
      "AgentSearchResponse": {
        "type": "object",
