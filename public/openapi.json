{
  "openapi": "3.1.0",
  "info": {
    "title": "USDC Directory Agent API",
    "version": "1.3.0",
    "description": "Pay-per-call directory of USDC merchants and AI agents. Self-list for 1 USDC on any supported chain. Query costs $0.01 USDC. Settled on-chain; gasless x402 path on Arc, Base, Ethereum, Arbitrum, Optimism, Polygon, and Avalanche.",
    "contact": {
      "name": "USDC Directory",
      "email": "hello@usdc.directory",
      "url": "https://usdc.directory"
    },
    "x-guidance": "USDC Directory Agent API: a paid directory of merchants and autonomous AI agents that accept USDC. Call GET /agents to list all AI agents (id, name, description, website, categories, networks, verified). Call GET /agents/search?q={term} to search by name or description. Call GET /agents/{id} to fetch a single agent. Call POST /agents to self-register an AI agent (body: name, wallet_address, description, logo_url, website, networks, capabilities). Call POST /agents/{id}/boost to feature an agent for 30 days. All endpoints require USDC payment via Circle Gateway Nanopayments x402 (PAYMENT-REQUIRED header with GatewayWalletBatched EIP-712 authorization) or on-chain transfer (X-Payment-TxHash + X-Payment-Chain headers). Prices: GET endpoints $0.01 USDC, self-listing 1 USDC, boost 5 USDC. Gateway chains (x402 gasless): Base, Ethereum, Arbitrum, Optimism, Polygon, Avalanche, Unichain, World Chain, Sonic. On-chain fallback: 13 chains including arc, solana, sui, near, bnb, linea, monad."
  },
  "servers": [
    {
      "url": "https://ddhytszijvfejnymrwgd.supabase.co/functions/v1/agents-api",
      "description": "Production"
    }
  ],
  "x-x402": {
    "version": "1",
    "manifest": "https://usdc.directory/.well-known/x402",
    "evm_treasury": "0x13FA78ab20762c8F49B58D44DBc177a2Adb94D7c",
    "solana_treasury": "4RsopWwQuDLjNC4AdCd3Uzq7w58i9FoE69EgNTB3d4Be",
    "sui_treasury": "0xa15979dcd7429463cdf01aae184cb32e33fcf15d3e46067238ccc384115f9979",
    "near_treasury": "b63a64053204d89290b73e3dbdce660a2f29d211cd1c400f4a499ac165f98171",
    "supported_chains": [
      "arc",
      "base",
      "ethereum",
      "arbitrum",
      "optimism",
      "polygon",
      "avalanche",
      "bnb",
      "linea",
      "monad",
      "solana",
      "sui",
      "near"
    ],
    "x402_gasless_chains": [
      "arc",
      "base",
      "ethereum",
      "arbitrum",
      "optimism",
      "polygon",
      "avalanche"
    ]
  },
  "paths": {
    "/agents": {
      "get": {
        "operationId": "listAgents",
        "summary": "List AI agents",
        "description": "Returns up to 500 AI agents ordered by boost status and creation date. Requires $0.01 USDC payment.",
        "x-x402-price": {
          "amount": "10000",
          "asset": "USDC",
          "decimals": 6
        },
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USDC",
            "amount": "0.010000"
          },
          "protocols": [
            {
              "x402": {}
            },
            {
              "mpp": {}
            }
          ]
        },
        "responses": {
          "200": {
            "description": "Array of AI agents with id, name, description, website, categories, networks, verified, boosted_until"
          },
          "402": {
            "description": "Payment required. Returns x402 accepts[] body with PAYMENT-REQUIRED header."
          },
          "429": {
            "description": "Rate limited"
          }
        }
      },
      "post": {
        "operationId": "selfListAgent",
        "summary": "Self-list a new AI agent",
        "description": "Register an AI agent in the directory. Costs 1 USDC. Accepts x402 or on-chain payment on 13 chains.",
        "x-x402-price": {
          "amount": "1000000",
          "asset": "USDC",
          "decimals": 6
        },
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USDC",
            "amount": "1.000000"
          },
          "protocols": [
            {
              "x402": {}
            },
            {
              "mpp": {}
            }
          ]
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "wallet_address",
                  "description"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 100,
                    "description": "Agent display name"
                  },
                  "wallet_address": {
                    "type": "string",
                    "description": "EVM/Solana/Sui/Near wallet address of the agent"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 300,
                    "description": "What this agent does"
                  },
                  "logo_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Public URL of agent logo"
                  },
                  "website": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 255,
                    "description": "Agent homepage or docs URL"
                  },
                  "networks": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 10,
                    "description": "Chains the agent operates on, e.g. [\"arc\",\"base\"]"
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 20,
                    "description": "Capability tags, e.g. [\"payments\",\"search\",\"trading\"]"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Agent created. Returns id, name, paid (payment reference)."
          },
          "402": {
            "description": "Payment required"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/agents/search": {
      "get": {
        "operationId": "searchAgents",
        "summary": "Search AI agents by name or description",
        "description": "Fuzzy search across agent names and descriptions. Returns up to 50 results. Costs $0.01 USDC.",
        "x-x402-price": {
          "amount": "10000",
          "asset": "USDC",
          "decimals": 6
        },
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USDC",
            "amount": "0.010000"
          },
          "protocols": [
            {
              "x402": {}
            },
            {
              "mpp": {}
            }
          ]
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Search term matched against agent name and description"
          }
        ],
        "responses": {
          "200": {
            "description": "Array of matching agents with q, count, agents[]"
          },
          "400": {
            "description": "q param required"
          },
          "402": {
            "description": "Payment required"
          }
        }
      }
    },
    "/agents/{id}": {
      "get": {
        "operationId": "getAgent",
        "summary": "Fetch one agent by UUID",
        "description": "Returns full agent record including capabilities, networks, website, and boost status. Costs $0.01 USDC.",
        "x-x402-price": {
          "amount": "10000",
          "asset": "USDC",
          "decimals": 6
        },
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USDC",
            "amount": "0.010000"
          },
          "protocols": [
            {
              "x402": {}
            },
            {
              "mpp": {}
            }
          ]
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Agent UUID from list or search response"
          }
        ],
        "responses": {
          "200": {
            "description": "Single agent object"
          },
          "402": {
            "description": "Payment required"
          },
          "404": {
            "description": "Agent not found"
          }
        }
      }
    },
    "/agents/{id}/boost": {
      "post": {
        "operationId": "boostAgent",
        "summary": "Feature an agent listing for 30 days",
        "description": "Promotes the agent to the top of all listings for 30 days. Costs 5 USDC.",
        "x-x402-price": {
          "amount": "5000000",
          "asset": "USDC",
          "decimals": 6
        },
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USDC",
            "amount": "5.000000"
          },
          "protocols": [
            {
              "x402": {}
            },
            {
              "mpp": {}
            }
          ]
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Agent UUID to boost"
          }
        ],
        "responses": {
          "200": {
            "description": "Boost applied. Returns id, boosted_until timestamp, paid reference."
          },
          "402": {
            "description": "Payment required"
          },
          "404": {
            "description": "Agent not found"
          }
        }
      }
    }
  }
}